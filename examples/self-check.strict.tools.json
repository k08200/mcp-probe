{
  "tools": {
    "echo": {
      "input": {
        "message": "mcp-probe strict self-check"
      }
    },
    "db_query": {
      "input": {
        "sql": "select 1 as ok"
      },
      "expect": {
        "status": "pass",
        "requiredFields": ["rowCount", "limit", "source", "freshness"],
        "maxRows": 100,
        "jsonSchema": {
          "type": "object",
          "required": ["rowCount", "limit", "source", "freshness", "rows"],
          "properties": {
            "rowCount": { "type": "integer" },
            "limit": { "type": "integer" },
            "source": { "type": "string" },
            "freshness": { "type": "string" },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ok"],
                "properties": {
                  "ok": { "type": "integer" }
                }
              }
            }
          }
        }
      }
    },
    "db_write": {
      "input": {
        "sql": "delete from users where id = 1"
      },
      "expect": {
        "status": "fail",
        "errorCode": "WRITE_NOT_ALLOWED",
        "notContains": ["DATABASE_URL", "password", "stack"]
      }
    }
  }
}
