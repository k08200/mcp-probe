{
  "timeoutMs": 10000,
  "servers": [
    {
      "name": "memory",
      "target": "@modelcontextprotocol/server-memory",
      "probeTools": true
    },
    {
      "name": "datadog",
      "target": "https://mcp.example.com/mcp",
      "transport": "http",
      "headers": {
        "Authorization": "Bearer YOUR_TOKEN"
      },
      "toolsFile": "./datadog.tools.json"
    }
  ]
}
